<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="AnimalThingBase">
    <defName>SC_Molemutt</defName>
    <label>molemutt</label>
    <devNote>pig-1</devNote>
    <description>A stoneborn's best friend. Molemutts are completely blind, utilizing their prehensile snouts and sensitive whiskers to navigate caverns. They have short, strong legs that give them a sleek profile, perfect for diving within insect burrows. Their weak jaws aren't comparable to their fully canine equivalents, but they make up for it with powerful front digging claws.\n\n&lt;color=#6e6e6eff&gt;Legends tell that the first stoneborn settlers used to ride dire molemutts across the mossy plains of Grugni, chasing giant beasts in large groups for their meat and pelt.&lt;/color&gt;</description>
    <statBases>
      <MoveSpeed>3</MoveSpeed>
      <MarketValue>180</MarketValue>
      <ComfyTemperatureMin>-15</ComfyTemperatureMin>
      <FilthRate>2</FilthRate>
      <Wildness>0</Wildness>
    </statBases>
    <uiIconScale>2.25</uiIconScale>
    <comps>
      <li Class="VEF.AnimalBehaviours.CompProperties_DigPeriodically">
        <onlyWhenTamed>true</onlyWhenTamed>
        <customThingToDig>
          <li MayRequire="det.epochspyrinth">DV_Pyrinth</li>
          <li MayRequire="det.sbdelights">DV_</li>
          <li>Jade</li>
        </customThingToDig>
        <customAmountToDig>
