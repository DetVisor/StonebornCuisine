          <li>3</li>
          <li>3</li>
          <li>3</li>
          <li>3</li>
          <li>5</li>
          <li>5</li>
          <li>5</li>
          <li>5</li>
          <li>5</li>
          <li>5</li>
        </customAmountToDig>
        <ticksToDig>60000</ticksToDig>
      </li>
    </comps>
    <tools>
      <li>
        <label>left claws</label>
