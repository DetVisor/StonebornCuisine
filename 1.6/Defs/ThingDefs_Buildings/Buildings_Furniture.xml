                        <li>SC_FlourRaw</li>
                        <li>DV_DwarvenFoods</li>
                        <li>FoodMeals</li>
                        <li>Drugs</li>
                    </categories>
                    <thingDefs>
                        <li>SC_Feast_JellyGlazedShank</li>
                        <li>SC_Feast_RoastedMegascarab</li>
                        <li>SC_Feast_MushroomSoup</li>
                        <li>SC_Feast_RockdoughPizza</li>
                        <li>SC_Feast_CrustedFillet</li>

                        <li>SC_CheesePie</li>
