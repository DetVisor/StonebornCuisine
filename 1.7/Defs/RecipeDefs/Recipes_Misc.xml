<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <RecipeDef ParentName="CookMealBase">
        <defName>SC_PrepareIceCream</defName>
        <label>prepare ice cream</label>
        <description>Mix milk and insect jelly thoroughly into melted ice cream.</description>
        <jobString>Preparing ice cream.</jobString>
        <workAmount>1500</workAmount>
        <workSpeedStat>CookSpeed</workSpeedStat>
        <requiredGiverWorkType>Cooking</requiredGiverWorkType>
        <effectWorking>Cook</effectWorking>
        <soundWorking>Recipe_CookMeal</soundWorking>
        <allowMixingIngredients>true</allowMixingIngredients>
        <researchPrerequisites>
            <li>SC_FeastGalore</li>
        </researchPrerequisites>
        <ingredients>
            <li>
                <filter>
                    <thingDefs>
                        <li>SC_DwarvenMilk</li>
                        <li>Milk</li>
                        <li MayRequire="van.beasts">DA_MufftonMilk</li>
                    </thingDefs>
                </filter>
                <count>60</count>
            </li>
            <li>
                <filter>
                    <thingDefs>
                        <li>InsectJelly</li>
                    </thingDefs>
                </filter>
                <count>15</count>
            </li>
        </ingredients>
        <defaultIngredientFilter>
            <disallowedThingDefs>
                <li>Meat_Human</li>
                <li>Meat_Megaspider</li>
            </disallowedThingDefs>
        </defaultIngredientFilter>
        <products>
            <SC_MeltedFeast_IceCream>16</SC_MeltedFeast_IceCream>
        </products>
        <workSkill>Cooking</workSkill>
        <displayPriority>100</displayPriority>
    </RecipeDef>

