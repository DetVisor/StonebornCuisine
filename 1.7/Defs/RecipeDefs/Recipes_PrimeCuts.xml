    <RecipeDef ParentName="CookMealBase">
        <defName>SC_CookCountryFriedMuffalo</defName>
        <label>cook country-fried muffalo</label>
        <description>Cook muffalo t-bone into country-fried muffalo.</description>
        <jobString>Cooking country-fried muffalo.</jobString>
        <workAmount>750</workAmount>
        <workSpeedStat>CookSpeed</workSpeedStat>
        <requiredGiverWorkType>Cooking</requiredGiverWorkType>
        <effectWorking>Cook</effectWorking>
        <soundWorking>Recipe_CookMeal</soundWorking>
        <allowMixingIngredients>true</allowMixingIngredients>
        <researchPrerequisites>
            <li>SC_PrimeCuisine</li>
        </researchPrerequisites>
        <ingredients>
            <li>
                <filter>
                    <thingDefs>
                        <li>SC_MuffaloT-bone</li>
                    </thingDefs>
                </filter>
                <count>12</count>
            </li>
            <li>
                <filter>
                    <categories>
                        <li>EggsUnfertilized</li>
                        <li>EggsFertilized</li>
                    </categories>
                </filter>
                <count>25</count>
            </li>
            <li>
                <filter>
                    <thingDefs>
                        <li>SC_AssortedHerbs</li>
                    </thingDefs>
                </filter>
                <count>25</count>
            </li>
        </ingredients>
        <defaultIngredientFilter>
            <disallowedThingDefs>
                <li>Meat_Human</li>
                <li>Meat_Megaspider</li>
            </disallowedThingDefs>
        </defaultIngredientFilter>
        <products>
            <SC_CountryFriedMuffalo>4</SC_CountryFriedMuffalo>
        </products>
        <workSkill>Cooking</workSkill>
        <displayPriority>100</displayPriority>
    </RecipeDef>

