<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <ThingDef ParentName="OrganicProductBase">
        <defName>SC_RockbullTenderloin</defName>
        <label>rockbull tenderloin</label>
        <description>Thick chunks of meat from the most tender part of a rockbull. Quite prized, as most other parts of the animal tend to be quite tough and chewy.\n\n&lt;color=#6e6e6eff&gt;Stoneborn royal hall etiquette considers rockbull tenderloin as the finest cut to serve to an underlord, but many underlords often prefer more exotic game, like crestel or baskar.&lt;/color&gt;</description>
        <graphicData>
            <texPath>Things/Item/Resource/PrimeCuts/Raw/RockbullTenderloin</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <statBases>
            <Mass>0.08</Mass>
            <MarketValue>4</MarketValue>
            <Nutrition>0.14</Nutrition>
            <Flammability>1</Flammability>
            <FoodPoisonChanceFixedHuman>0.02</FoodPoisonChanceFixedHuman>
        </statBases>
        <thingCategories>
            <li>MeatRaw</li>
            <li>DV_PrimeCuts</li>
        </thingCategories>
        <ingestible>
            <foodType>Meat</foodType>
            <preferability>DesperateOnly</preferability>
            <ingestEffect>EatMeat</ingestEffect>
            <ingestSound>RawMeat_Eat</ingestSound>
            <specialThoughtDirect>AteRawFood</specialThoughtDirect>
            <specialThoughtAsIngredient>SC_AteCookedPrimeCut</specialThoughtAsIngredient>
        </ingestible>
        <comps>
            <li Class="CompProperties_Rottable">
                <daysToRotStart>5</daysToRotStart>
                <rotDestroys>True</rotDestroys>
            </li>
        </comps>
    </ThingDef>

    <ThingDef ParentName="OrganicProductBase">
